<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SUSALUD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --azul-oscuro: #003A70;
            --azul-medio:  #0057A8;
            --azul-claro:  #0079C2;
            --naranja:     #F7941D;
            --naranja-osc: #D97B0A;
            --gris-bg:     #F4F7FB;
            --gris-borde:  #D1DCE8;
            --texto-prin:  #1A2B3C;
            --texto-sec:   #5A6E82;
        }

        * { font-family: 'Inter', sans-serif; }
        body { background: var(--gris-bg); color: var(--texto-prin); }

        .header-top {
            background: var(--azul-oscuro);
            padding: 6px 0;
            font-size: .78rem;
            color: rgba(255,255,255,.75);
        }
        .header-top a { color: rgba(255,255,255,.75); text-decoration: none; }
        .header-top a:hover { color: #fff; }

        .navbar-main {
            background: #fff;
            border-bottom: 3px solid var(--naranja);
            box-shadow: 0 2px 12px rgba(0,58,112,.10);
            padding: 10px 0;
        }
        .navbar-brand img { height: 44px; }
        .brand-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--azul-oscuro);
            letter-spacing: -.3px;
        }
        .brand-sub {
            font-size: .68rem;
            color: var(--azul-claro);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .nav-modulo {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .nav-modulo a {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 16px;
            border-radius: 8px;
            font-size: .84rem;
            font-weight: 600;
            color: var(--texto-sec);
            text-decoration: none;
            transition: background .18s, color .18s;
            border: 1.5px solid transparent;
        }
        .nav-modulo a:hover {
            background: var(--gris-bg);
            color: var(--azul-oscuro);
            border-color: var(--gris-borde);
        }
        .nav-modulo a.activo {
            background: #E8F0FB;
            color: var(--azul-medio);
            border-color: #C3D5EF;
        }

        .footer {
            background: var(--azul-oscuro);
            color: rgba(255,255,255,.65);
            padding: 32px 0 20px;
            margin-top: 60px;
            font-size: .82rem;
        }
        .footer-title { color: #fff; font-weight: 700; font-size: .92rem; margin-bottom: 10px; }
        .footer hr { border-color: rgba(255,255,255,.12); margin: 20px 0 14px; }
        .footer-bottom { font-size: .75rem; color: rgba(255,255,255,.45); }
        .footer a { color: rgba(255,255,255,.65); text-decoration: none; }
        .footer a:hover { color: var(--naranja); }

        .form-label {
            font-size: .78rem;
            font-weight: 600;
            color: var(--texto-sec);
            text-transform: uppercase;
            letter-spacing: .4px;
            margin-bottom: 5px;
        }
        .form-control, .form-select {
            border: 1.5px solid var(--gris-borde);
            border-radius: 8px;
            font-size: .9rem;
            padding: 9px 13px;
            color: var(--texto-prin);
            transition: border-color .2s, box-shadow .2s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--azul-claro);
            box-shadow: 0 0 0 3px rgba(0,121,194,.12);
            outline: none;
        }
        .form-control::placeholder { color: #b0bec8; }

        .btn-buscar {
            background: var(--naranja);
            color: #fff;
            font-weight: 700;
            font-size: .92rem;
            padding: 10px 28px;
            border: none;
            border-radius: 8px;
            letter-spacing: .3px;
            transition: background .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 4px 16px rgba(247,148,29,.35);
        }
        .btn-buscar:hover {
            background: var(--naranja-osc);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(247,148,29,.45);
            color: #fff;
        }
        .btn-buscar:active { transform: translateY(0); }

        .btn-limpiar {
            background: transparent;
            color: var(--azul-medio);
            font-weight: 600;
            font-size: .88rem;
            padding: 10px 20px;
            border: 1.5px solid var(--gris-borde);
            border-radius: 8px;
            transition: background .2s, border-color .2s;
        }
        .btn-limpiar:hover {
            background: var(--gris-bg);
            border-color: var(--azul-claro);
            color: var(--azul-oscuro);
        }

        .search-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 8px 40px rgba(0,58,112,.13);
            padding: 32px 36px;
            margin-top: -36px;
            position: relative;
            z-index: 10;
            border-top: 4px solid var(--naranja);
        }
        .search-card-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--azul-oscuro);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .search-card-title i { color: var(--naranja); font-size: 1.15rem; }

        .table-wrapper {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 16px rgba(0,58,112,.07);
            overflow: hidden;
            border: 1px solid var(--gris-borde);
        }
        .table { margin: 0; font-size: .86rem; }
        .table thead th {
            background: var(--azul-oscuro);
            color: #fff;
            font-weight: 600;
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 12px 16px;
            border: none;
            white-space: nowrap;
        }
        .table tbody td {
            padding: 12px 16px;
            border-color: #ECF0F7;
            vertical-align: middle;
            color: var(--texto-prin);
        }
        .table tbody tr:hover { background: #F0F5FC; }

        .empty-state {
            text-align: center;
            padding: 64px 24px;
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--gris-borde);
        }
        .empty-state i { font-size: 3rem; color: #C5D5E8; margin-bottom: 16px; display: block; }
        .empty-state h5 { font-weight: 700; color: var(--azul-oscuro); margin-bottom: 6px; }
        .empty-state p { color: var(--texto-sec); font-size: .9rem; }

        .alert-custom {
            background: #FFF1F0;
            border: 1.5px solid #FFB8B8;
            border-radius: 10px;
            color: #A8071A;
            font-size: .9rem;
            padding: 14px 18px;
        }

        .hero {
            background: linear-gradient(135deg, var(--azul-oscuro) 0%, var(--azul-medio) 60%, var(--azul-claro) 100%);
            padding: 48px 0 56px;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(247,148,29,.2);
            border: 1px solid rgba(247,148,29,.5);
            color: #FFC872;
            font-size: .75rem;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 100px;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }
        .hero h1 {
            font-size: clamp(1.6rem, 4vw, 2.4rem);
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
            margin-bottom: 10px;
        }
        .hero h1 span { color: var(--naranja); }
        .hero p {
            font-size: .97rem;
            color: rgba(255,255,255,.80);
            max-width: 540px;
            margin-bottom: 0;
        }
        .hero-stats { display: flex; gap: 28px; margin-top: 28px; }
        .hero-stat-val { font-size: 1.5rem; font-weight: 700; color: #fff; }
        .hero-stat-lbl { font-size: .72rem; color: rgba(255,255,255,.65); text-transform: uppercase; letter-spacing: .4px; }
        .hero-divider { width: 1px; background: rgba(255,255,255,.2); }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

<div class="header-top">
    <div class="container d-flex justify-content-between align-items-center">
        <span><i class="bi bi-globe2 me-1"></i> Portal del Estado Peruano</span>
        <div class="d-flex gap-3">
            <a href="#"><i class="bi bi-question-circle me-1"></i>Ayuda</a>
            <a href="#"><i class="bi bi-telephone me-1"></i>(01) 213-0800</a>
        </div>
    </div>
</div>

<nav class="navbar-main">
    <div class="container d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <svg width="40" height="44" viewBox="0 0 40 44" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="0" width="13" height="44" fill="#D91023"/>
                <rect x="13" y="0" width="14" height="44" fill="#fff"/>
                <rect x="27" y="0" width="13" height="44" fill="#D91023"/>
            </svg>
            <div>
                <div class="brand-title">SUSALUD</div>
                <div class="brand-sub">Superintendencia Nacional de Salud</div>
            </div>
        </div>
        <div class="nav-modulo">
            <a href="@Url.Action("Index", "Home")"
               class="@(ViewData["Modulo"]?.ToString() == "RENIPRESS" ? "activo" : "")">
                <i class="bi bi-hospital"></i> RENIPRESS
            </a>
            <a href="@Url.Action("Estadisticas", "Ira")"
               class="@(ViewData["Modulo"]?.ToString() == "IRA" ? "activo" : "")">
                <i class="bi bi-bar-chart-line"></i> Estadísticas IRA
            </a>
            <a href="@Url.Action("Estadisticas", "Poblacion")"
               class="@(ViewData["Modulo"]?.ToString() == "POBLACION" ? "activo" : "")">
                <i class="bi bi-shield-plus"></i> Análisis Epidemiológico
            </a>
        </div>
    </div>
</nav>

@RenderBody()

<footer class="footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="footer-title">SUSALUD</div>
                <p>Superintendencia Nacional de Salud — Organismo Técnico Especializado del Ministerio de Salud del Perú.</p>
            </div>
            <div class="col-md-4">
                <div class="footer-title">RENIPRESS</div>
                <p>Registro Nacional de Instituciones Prestadoras de Servicios de Salud. Sistema de consulta pública.</p>
            </div>
            <div class="col-md-4">
                <div class="footer-title">Contacto</div>
                <p><i class="bi bi-telephone me-1"></i>(01) 213-0800<br/>
                   <i class="bi bi-envelope me-1"></i>info@susalud.gob.pe<br/>
                   <i class="bi bi-geo-alt me-1"></i>Lima, Perú</p>
            </div>
        </div>
        <hr/>
        <div class="d-flex justify-content-between flex-wrap gap-2 footer-bottom">
            <span>© @DateTime.Now.Year SUSALUD — Gobierno del Perú. Todos los derechos reservados.</span>
            <span>RENIPRESS v2.0</span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
